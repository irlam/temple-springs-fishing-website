DirectoryIndex index.html
Options -Indexes
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'none'"
Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=()"
<FilesMatch "\.(php|html)$">
Header always set Cache-Control "private, no-store, max-age=0"
</FilesMatch>
<Files "sw.js">
Header always set Cache-Control "no-cache"
</Files>
</IfModule>
